prefix=/c/gcdev64/gnucash/releases/inst
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libecpg_compat
Description: PostgreSQL libecpg_compat library
URL: https://www.postgresql.org/
Version: 17.5
Requires: 
Requires.private: libecpg, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg_compat
Libs.private: -L/c/gcdev64/gnucash/releases/inst/lib -L/c/gcdev64/msys2/mingw32/lib -L/usr/lib -lecpg -lpgcommon -lpgport -lpq -lm
