prefix=/c/gcdev64/gnucash/releases/inst
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libecpg
Description: PostgreSQL libecpg library
URL: https://www.postgresql.org/
Version: 17.5
Requires: 
Requires.private: libpq, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg
Libs.private: -L/c/gcdev64/gnucash/releases/inst/lib -L/c/gcdev64/msys2/mingw32/lib -L/usr/lib -lpgcommon -lpgport -lpq -lm
