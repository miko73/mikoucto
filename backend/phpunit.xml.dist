<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <env name="APP_SECRET" value="test-only-secret" force="true"/>
        <env name="KERNEL_CLASS" value="App\Kernel"/>
        <env name="DATABASE_URL" value="postgresql://test:test@127.0.0.1:1/mikoucto_test?connect_timeout=1" force="true"/>
    </php>
    <testsuites>
        <testsuite name="backend">
            <directory>tests</directory>
            <exclude>tests/Integration</exclude>
        </testsuite>
    </testsuites>
</phpunit>
