{
    "name": "mikoucto/backend",
    "description": "Backend API aplikace mikoucto",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-pdo_pgsql": "*",
        "api-platform/symfony": "^4.2",
        "doctrine/dbal": "^4.3",
        "doctrine/migrations": "^3.9",
        "firebase/php-jwt": "^6.11 || ^7.0",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
    "config": {
        "allow-plugins": {"symfony/runtime": true},
        "sort-packages": true
    },
    "scripts": {"test": "phpunit"}
}
